# Copie para .dev.vars (desenvolvimento local). Em produção use `npx wrangler secret put NOME`.
# Nunca commite .dev.vars nem valores reais.

# Código pedido uma única vez, na criação do administrador (qualquer texto longo e aleatório)
SETUP_TOKEN=troque-por-um-codigo-longo-e-aleatorio

# 32 bytes em base64 — cifra os tokens OAuth no banco e assina os links públicos.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Google Cloud Console → APIs e serviços → Credenciais → ID do cliente OAuth (aplicativo da Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcional: chave da PageSpeed Insights API (Google Cloud) para medir velocidade mobile
PSI_API_KEY=
